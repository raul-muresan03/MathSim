# Backend
# Required: generate a random key as described in README.md; never commit it.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000
# Local Docker Compose only. If changing the password, update both values.
POSTGRES_PASSWORD=mathsim_local
DATABASE_URL=postgresql://mathsim:mathsim_local@postgres:5432/mathsim
# Vercel backend: set DATABASE_URL to Neon's pooled URL with its SSL parameters.
# Example: postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
